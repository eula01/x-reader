{
  "manifest_version": 3,
  "name": "X List Focus",
  "version": "1.0.4",
  "description": "Limits X to four list timelines and direct tweet links.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["page-hook.js"],
      "matches": ["https://x.com/*", "https://twitter.com/*"]
    }
  ],
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["config.js", "url-matcher.js", "content.js"],
      "css": ["overlay.css"],
      "run_at": "document_start"
    }
  ]
}
